# ===================================================================================

# Extract directory name from full path of the file currently being processed.
# Note that CMake 2.8.3 introduced CMAKE_CURRENT_LIST_DIR. We reimplement it
# for older versions of CMake to support these as well.
if(CMAKE_VERSION VERSION_LESS "2.8.3")
  get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
endif()

if(NOT DEFINED @PROJECT_NAME@_CONFIG_SUBDIR)
  set(@PROJECT_NAME@_CONFIG_SUBDIR "/abi-${ANDROID_NDK_ABI_NAME}")
endif()

set(@PROJECT_NAME@_CONFIG_PATH "${CMAKE_CURRENT_LIST_DIR}${@PROJECT_NAME@_CONFIG_SUBDIR}")
if(EXISTS "${@PROJECT_NAME@_CONFIG_PATH}/@PROJECT_NAME@Config.cmake")
  include("${@PROJECT_NAME@_CONFIG_PATH}/@PROJECT_NAME@Config.cmake")
else()
  if(NOT @PROJECT_NAME@_FIND_QUIETLY)
    message(WARNING "Found @PROJECT_NAME@ Android Pack but it has no binaries compatible with your ABI (can't find: ${@PROJECT_NAME@_CONFIG_SUBDIR})")
  endif()
  set(@PROJECT_NAME@_FOUND FALSE)
endif()
