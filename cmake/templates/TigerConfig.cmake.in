# ===================================================================================
#  The @PROJECT_NAME@ CMake configuration file
#
#             ** File generated automatically, do not modify **
#
#  Usage from an external project:
#    In your CMakeLists.txt, add these lines:
#
#    find_package(@PROJECT_NAME@ REQUIRED)
#    include_directories(${@PROJECT_NAME@_INCLUDE_DIRS}) # Not needed for CMake >= 2.8.11
#    target_link_libraries(MY_TARGET_NAME ${@PROJECT_NAME@_LIBS})
#
#    Or you can search for specific @PROJECT_NAME@ modules:
#
#    find_package(@PROJECT_NAME@ REQUIRED core videoio)
#
#    You can also mark @PROJECT_NAME@ components as optional:

#    find_package(@PROJECT_NAME@ REQUIRED core OPTIONAL_COMPONENTS viz)
#
#    If the module is found then @PROJECT_NAME@_<MODULE>_FOUND is set to TRUE.
#
#    This file will define the following variables:
#      - @PROJECT_NAME@_LIBS                     : The list of all imported targets for @PROJECT_NAME@ modules.
#      - @PROJECT_NAME@_INCLUDE_DIRS             : The @PROJECT_NAME@ include directories.
#      - @PROJECT_NAME@_COMPUTE_CAPABILITIES     : The version of compute capability.
#      - @PROJECT_NAME@_ANDROID_NATIVE_API_LEVEL : Minimum required level of Android API.
#      - @PROJECT_NAME@_VERSION                  : The version of this @PROJECT_NAME@ build: "@TIGER_VERSION_PLAIN@"
#      - @PROJECT_NAME@_VERSION_MAJOR            : Major version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_MAJOR@"
#      - @PROJECT_NAME@_VERSION_MINOR            : Minor version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_MINOR@"
#      - @PROJECT_NAME@_VERSION_PATCH            : Patch version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_PATCH@"
#      - @PROJECT_NAME@_VERSION_STATUS           : Development status of this build: "@TIGER_VERSION_STATUS@"
#
#    Advanced variables:
#      - @PROJECT_NAME@_SHARED                   : Use @PROJECT_NAME@ as shared library
#      - @PROJECT_NAME@_INSTALL_PATH             : @PROJECT_NAME@ location
#      - @PROJECT_NAME@_LIB_COMPONENTS           : Present @PROJECT_NAME@ modules list
#      - @PROJECT_NAME@_USE_MANGLED_PATHS        : Mangled @PROJECT_NAME@ path flag
#
#    Deprecated variables:
#      - @PROJECT_NAME@_VERSION_TWEAK            : Always "0"
#
# ===================================================================================

# ======================================================
#  Version variables:
# ======================================================
SET(@PROJECT_NAME@_VERSION @TIGER_VERSION_PLAIN@)
SET(@PROJECT_NAME@_VERSION_MAJOR  @TIGER_VERSION_MAJOR@)
SET(@PROJECT_NAME@_VERSION_MINOR  @TIGER_VERSION_MINOR@)
SET(@PROJECT_NAME@_VERSION_PATCH  @TIGER_VERSION_PATCH@)
SET(@PROJECT_NAME@_VERSION_TWEAK  0)
SET(@PROJECT_NAME@_VERSION_STATUS "@TIGER_VERSION_STATUS@")

include(FindPackageHandleStandardArgs)

if(NOT CMAKE_VERSION VERSION_LESS 2.8.8
    AND @PROJECT_NAME@_FIND_COMPONENTS  # prevent excessive output
)
  # HANDLE_COMPONENTS was introduced in CMake 2.8.8
  list(APPEND _@PROJECT_NAME@_FPHSA_ARGS HANDLE_COMPONENTS)
  # The missing components will be handled by the FindPackageHandleStandardArgs
  # module.
  set(_@PROJECT_NAME@_HANDLE_COMPONENTS_MANUALLY FALSE)
else()
  # The missing components will be handled by this config.
  set(_@PROJECT_NAME@_HANDLE_COMPONENTS_MANUALLY TRUE)
endif()

# Extract directory name from full path of the file currently being processed.
# Note that CMake 2.8.3 introduced CMAKE_CURRENT_LIST_DIR. We reimplement it
# for older versions of CMake to support these as well.
if(CMAKE_VERSION VERSION_LESS "2.8.3")
  get_filename_component(CMAKE_CURRENT_LIST_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
endif()

# Extract the directory where *this* file has been installed (determined at cmake run-time)
# Get the absolute path with no ../.. relative marks, to eliminate implicit linker warnings
get_filename_component(@PROJECT_NAME@_CONFIG_PATH "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
get_filename_component(@PROJECT_NAME@_INSTALL_PATH "${@PROJECT_NAME@_CONFIG_PATH}/@TIGER_INSTALL_PATH_RELATIVE_CONFIGCMAKE@" REALPATH)

# Search packages for host system instead of packages for target system.
# in case of cross compilation this macro should be defined by toolchain file
if(NOT COMMAND find_host_package)
    macro(find_host_package)
        find_package(${ARGN})
    endmacro()
endif()
if(NOT COMMAND find_host_program)
    macro(find_host_program)
        find_program(${ARGN})
    endmacro()
endif()


@CUDA_CONFIGCMAKE@
@ANDROID_CONFIGCMAKE@

@IPPICV_CONFIGCMAKE@
@IPPIW_CONFIGCMAKE@

# Some additional settings are required if @PROJECT_NAME@ is built as static libs
set(@PROJECT_NAME@_SHARED @BUILD_SHARED_LIBS@)

# Enables mangled install paths, that help with side by side installs
set(@PROJECT_NAME@_USE_MANGLED_PATHS @TIGER_USE_MANGLED_PATHS_CONFIGCMAKE@)

set(@PROJECT_NAME@_LIB_COMPONENTS @TIGER_MODULES_CONFIGCMAKE@)
set(__@PROJECT_NAME@_INCLUDE_DIRS @TIGER_INCLUDE_DIRS_CONFIGCMAKE@)

set(@PROJECT_NAME@_INCLUDE_DIRS "")
foreach(d ${__@PROJECT_NAME@_INCLUDE_DIRS})
  get_filename_component(__d "${d}" REALPATH)
  if(NOT EXISTS "${__d}")
    if(NOT @PROJECT_NAME@_FIND_QUIETLY)
      message(WARNING "@PROJECT_NAME@: Include directory doesn't exist: '${d}'. @PROJECT_NAME@ installation may be broken. Skip...")
    endif()
  else()
    list(APPEND @PROJECT_NAME@_INCLUDE_DIRS "${__d}")
  endif()
endforeach()
unset(__d)


if(NOT TARGET @TI_INTERNAL_NAME@_base)
  include(${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Modules${@PROJECT_NAME@_MODULES_SUFFIX}.cmake)
endif()

if(NOT CMAKE_VERSION VERSION_LESS "2.8.11")
  # Target property INTERFACE_INCLUDE_DIRECTORIES available since 2.8.11:
  # * http://www.cmake.org/cmake/help/v2.8.11/cmake.html#prop_tgt:INTERFACE_INCLUDE_DIRECTORIES
  foreach(__component ${@PROJECT_NAME@_LIB_COMPONENTS})
    if(TARGET ${__component})
      set_target_properties(
          ${__component}
          PROPERTIES
          INTERFACE_INCLUDE_DIRECTORIES "${@PROJECT_NAME@_INCLUDE_DIRS}"
      )
    endif()
  endforeach()
endif()


if(NOT DEFINED @PROJECT_NAME@_MAP_IMPORTED_CONFIG)
  if(CMAKE_GENERATOR MATCHES "Visual Studio" OR MSVC)
    # @PROJECT_NAME@ supports Debug and Release builds only.
    # But MSVS has 'RelWithDebInfo' 'MinSizeRel' configurations for applications.
    # By default CMake maps these configuration on the first available (Debug) which is wrong.
    # Non-Debug build of Application can't be used with @PROJECT_NAME@ Debug build (ABI mismatch problem)
    # Add mapping of RelWithDebInfo and MinSizeRel to Release here
    set(@PROJECT_NAME@_MAP_IMPORTED_CONFIG "RELWITHDEBINFO=!Release;MINSIZEREL=!Release")
  endif()
endif()
set(__remap_warnings "")
macro(ti_map_imported_config target)
  if(DEFINED @PROJECT_NAME@_MAP_IMPORTED_CONFIG) # list, "RELWITHDEBINFO=Release;MINSIZEREL=Release"
    get_target_property(__available_configurations ${target} IMPORTED_CONFIGURATIONS)
    foreach(remap ${@PROJECT_NAME@_MAP_IMPORTED_CONFIG})
      if(remap MATCHES "^(.+)=(!?)([^!]+)$")
        set(__remap_config "${CMAKE_MATCH_1}")
        set(__final_config "${CMAKE_MATCH_3}")
        set(__force_flag "${CMAKE_MATCH_2}")
        string(TOUPPER "${__final_config}" __final_config_upper)
        string(TOUPPER "${__remap_config}" __remap_config_upper)
        if(";${__available_configurations};" MATCHES ";${__remap_config_upper};" AND NOT "${__force_flag}" STREQUAL "!")
          # configuration already exists, skip remap
          set(__remap_warnings "${__remap_warnings}... Configuration already exists ${__remap_config} (skip mapping ${__remap_config} => ${__final_config}) (available configurations: ${__available_configurations})\n")
          continue()
        endif()
        if(__available_configurations AND NOT ";${__available_configurations};" MATCHES ";${__final_config_upper};")
          # skip, configuration is not available
          if(NOT "${__force_flag}" STREQUAL "!")
            set(__remap_warnings "${__remap_warnings}... Configuration is not available '${__final_config}' for ${target}, build may fail (available configurations: ${__available_configurations})\n")
          endif()
        endif()
        set_target_properties(${target} PROPERTIES
            MAP_IMPORTED_CONFIG_${__remap_config} "${__final_config}"
        )
      else()
        message(WARNING "Invalid entry of @PROJECT_NAME@_MAP_IMPORTED_CONFIG: '${remap}' (${@PROJECT_NAME@_MAP_IMPORTED_CONFIG})")
      endif()
    endforeach()
  endif()
endmacro()


# ==============================================================
#  Form list of modules (components) to find
# ==============================================================
if(NOT @PROJECT_NAME@_FIND_COMPONENTS)
  set(@PROJECT_NAME@_FIND_COMPONENTS ${@PROJECT_NAME@_LIB_COMPONENTS})
  list(REMOVE_ITEM @PROJECT_NAME@_FIND_COMPONENTS @TI_INTERNAL_NAME@_java)
  if(GTest_FOUND OR GTEST_FOUND)
    list(REMOVE_ITEM @PROJECT_NAME@_FIND_COMPONENTS @TI_INTERNAL_NAME@_ts)
  endif()
endif()

set(@PROJECT_NAME@_WORLD_COMPONENTS @TIGER_WORLD_MODULES@)

# expand short module names and see if requested components exist
foreach(__ticomponent ${@PROJECT_NAME@_FIND_COMPONENTS})
  # Store the name of the original component so we can set the
  # @PROJECT_NAME@_<component>_FOUND variable which can be checked by the user.
  set (__original_cvcomponent ${__ticomponent})
  if(NOT __ticomponent MATCHES "^@TI_INTERNAL_NAME@_")
    set(__ticomponent @TI_INTERNAL_NAME@_${__ticomponent})
  endif()
  list(FIND @PROJECT_NAME@_LIB_COMPONENTS ${__ticomponent} __ticomponentIdx)
  if(__ticomponentIdx LESS 0)
    if(_@PROJECT_NAME@_HANDLE_COMPONENTS_MANUALLY)
      # Either the component is required or the user did not set any components at
      # all. In the latter case, the @PROJECT_NAME@_FIND_REQUIRED_<component> variable
      # will not be defined since it is not set by this config. So let's assume
      # the implicitly set components are always required.
      if(NOT DEFINED @PROJECT_NAME@_FIND_REQUIRED_${__original_cvcomponent} OR
          @PROJECT_NAME@_FIND_REQUIRED_${__original_cvcomponent})
        message(FATAL_ERROR "${__ticomponent} is required but was not found")
      elseif(NOT @PROJECT_NAME@_FIND_QUIETLY)
        # The component was marked as optional using OPTIONAL_COMPONENTS
        message(WARNING "Optional component ${__ticomponent} was not found")
      endif()
    endif(_@PROJECT_NAME@_HANDLE_COMPONENTS_MANUALLY)
    #indicate that module is NOT found
    string(TOUPPER "${__ticomponent}" __ticomponentUP)
    set(${__ticomponentUP}_FOUND "${__ticomponentUP}_FOUND-NOTFOUND")
    set(@PROJECT_NAME@_${__original_cvcomponent}_FOUND FALSE)
  else()
    # Not using list(APPEND) here, because @PROJECT_NAME@_LIBS may not exist yet.
    # Also not clearing @PROJECT_NAME@_LIBS anywhere, so that multiple calls
    # to find_package(@PROJECT_NAME@) with different component lists add up.
    set(@PROJECT_NAME@_LIBS ${@PROJECT_NAME@_LIBS} "${__ticomponent}")
    #indicate that module is found
    string(TOUPPER "${__ticomponent}" __ticomponentUP)
    set(${__ticomponentUP}_FOUND 1)
    set(@PROJECT_NAME@_${__original_cvcomponent}_FOUND TRUE)
  endif()
  if(@PROJECT_NAME@_SHARED AND ";${@PROJECT_NAME@_WORLD_COMPONENTS};" MATCHES ";${__ticomponent};" AND NOT TARGET ${__ticomponent})
    get_target_property(__implib_dbg @TI_INTERNAL_NAME@_world IMPORTED_IMPLIB_DEBUG)
    get_target_property(__implib_release @TI_INTERNAL_NAME@_world  IMPORTED_IMPLIB_RELEASE)
    get_target_property(__location_dbg @TI_INTERNAL_NAME@_world IMPORTED_LOCATION_DEBUG)
    get_target_property(__location_release @TI_INTERNAL_NAME@_world  IMPORTED_LOCATION_RELEASE)
    get_target_property(__include_dir @TI_INTERNAL_NAME@_world INTERFACE_INCLUDE_DIRECTORIES)
    add_library(${__ticomponent} SHARED IMPORTED)
    set_target_properties(${__ticomponent} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${__include_dir}")
    if(__location_dbg)
      set_property(TARGET ${__ticomponent} APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
      set_target_properties(${__ticomponent} PROPERTIES
        IMPORTED_IMPLIB_DEBUG "${__implib_dbg}"
        IMPORTED_LINK_INTERFACE_LIBRARIES_DEBUG ""
        IMPORTED_LOCATION_DEBUG "${__location_dbg}"
      )
    endif()
    if(__location_release)
      set_property(TARGET ${__ticomponent} APPEND PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
      set_target_properties(${__ticomponent} PROPERTIES
        IMPORTED_IMPLIB_RELEASE "${__implib_release}"
        IMPORTED_LINK_INTERFACE_LIBRARIES_RELEASE ""
        IMPORTED_LOCATION_RELEASE "${__location_release}"
      )
    endif()
  endif()
  if(TARGET ${__ticomponent})
    ti_map_imported_config(${__ticomponent})
  endif()
endforeach()

if(__remap_warnings AND NOT @PROJECT_NAME@_FIND_QUIETLY)
  message("@PROJECT_NAME@: configurations remap warnings:\n${__remap_warnings}@PROJECT_NAME@: Check variable @PROJECT_NAME@_MAP_IMPORTED_CONFIG=${@PROJECT_NAME@_MAP_IMPORTED_CONFIG}")
endif()

# ==============================================================
# Compatibility stuff
# ==============================================================
set(@PROJECT_NAME@_LIBRARIES ${@PROJECT_NAME@_LIBS})

# Require C++11 features for @PROJECT_NAME@ modules
if(CMAKE_VERSION VERSION_LESS "3.1")
  if(NOT @PROJECT_NAME@_FIND_QUIETLY AND NOT @PROJECT_NAME@_HIDE_WARNING_COMPILE_FEATURES)
    message(STATUS "@PROJECT_NAME@: CMake version is low (${CMAKE_VERSION}, required 3.1+). Can't enable C++11 features.")
  endif()
else()
  set(__target @TI_INTERNAL_NAME@_base)
  if(TARGET @TI_INTERNAL_NAME@_world)
    set(__target @TI_INTERNAL_NAME@_world)
  endif()
  set(__compile_features cxx_std_11)  # CMake 3.8+
  if(DEFINED @PROJECT_NAME@_COMPILE_FEATURES)
    set(__compile_features ${@PROJECT_NAME@_COMPILE_FEATURES})  # custom override
  elseif(CMAKE_VERSION VERSION_LESS "3.8")
    set(__compile_features cxx_auto_type cxx_rvalue_references cxx_lambdas)
  endif()
  if(__compile_features)
    # Simulate exported result of target_compile_features(@TI_INTERNAL_NAME@_base PUBLIC ...)
    set_target_properties(${__target} PROPERTIES
        INTERFACE_COMPILE_FEATURES "${__compile_features}"
    )
  endif()
  unset(__target)
  unset(__compile_features)
endif()

#
# Some macros for samples
#
macro(ti_check_dependencies)
  set(TI_DEPENDENCIES_FOUND TRUE)
  foreach(d ${ARGN})
    if(NOT TARGET ${d})
      message(WARNING "@PROJECT_NAME@: Can't resolve dependency: ${d}")
      set(TI_DEPENDENCIES_FOUND FALSE)
      break()
    endif()
  endforeach()
endmacro()

# adds include directories in such way that directories from the @PROJECT_NAME@ source tree go first
function(ti_include_directories)
  set(__add_before "")
  file(TO_CMAKE_PATH "${@PROJECT_NAME@_INSTALL_PATH}" __baseDir)
  foreach(dir ${ARGN})
    get_filename_component(__abs_dir "${dir}" ABSOLUTE)
    if("${__abs_dir}" MATCHES "^${__baseDir}")
      list(APPEND __add_before "${dir}")
    else()
      include_directories(AFTER SYSTEM "${dir}")
    endif()
  endforeach()
  include_directories(BEFORE ${__add_before})
endfunction()

macro(ti_include_modules)
  include_directories(BEFORE "${@PROJECT_NAME@_INCLUDE_DIRS}")
endmacro()

macro(ti_include_modules_recurse)
  include_directories(BEFORE "${@PROJECT_NAME@_INCLUDE_DIRS}")
endmacro()

macro(ti_target_link_libraries)
  target_link_libraries(${ARGN})
endmacro()

# remove all matching elements from the list
macro(ti_list_filterout lst regex)
  foreach(item ${${lst}})
    if(item MATCHES "${regex}")
      list(REMOVE_ITEM ${lst} "${item}")
    endif()
  endforeach()
endmacro()

# We do not actually need REQUIRED_VARS to be checked for. Just use the
# installation directory for the status.
find_package_handle_standard_args(@PROJECT_NAME@ REQUIRED_VARS @PROJECT_NAME@_INSTALL_PATH
                                  VERSION_VAR @PROJECT_NAME@_VERSION ${_@PROJECT_NAME@_FPHSA_ARGS})
