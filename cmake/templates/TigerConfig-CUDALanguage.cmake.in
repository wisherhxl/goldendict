# Version Compute Capability from which @PROJECT_NAME@ has been compiled is remembered
set(@PROJECT_NAME@_COMPUTE_CAPABILITIES "${@PROJECT_NAME@_CUDA_CC}")

set(@PROJECT_NAME@_CUDA_VERSION "@CUDA_VERSION_STRING@")
set(@PROJECT_NAME@_USE_CUBLAS   "@HAVE_CUBLAS@")
set(@PROJECT_NAME@_USE_CUFFT    "@HAVE_CUFFT@")
set(@PROJECT_NAME@_USE_NVCUVID  "@HAVE_NVCUVID@")
set(@PROJECT_NAME@_USE_NVCUVENC "@HAVE_NVCUVENC@")
set(@PROJECT_NAME@_CUDNN_VERSION    "@CUDNN_VERSION@")
set(@PROJECT_NAME@_USE_CUDNN        "@HAVE_CUDNN@")
set(ENABLE_CUDA_FIRST_CLASS_LANGUAGE  ON)

if(NOT CUDAToolkit_FOUND)
  if(NOT CMAKE_VERSION VERSION_LESS 3.18)
    if(UNIX AND NOT CMAKE_CUDA_COMPILER AND NOT CUDAToolkit_ROOT)
      message(STATUS "Checking for CUDAToolkit in default location (/usr/local/cuda)")
      set(CUDA_PATH "/usr/local/cuda" CACHE INTERNAL "")
      set(ENV{CUDA_PATH} ${CUDA_PATH})
    endif()
    find_package(CUDAToolkit ${@PROJECT_NAME@_CUDA_VERSION} EXACT REQUIRED)
  else()
    message(FATAL_ERROR "Using @PROJECT_NAME@ compiled with CUDA as first class language requires CMake \>= 3.18.")
  endif()
else()
  if(CUDAToolkit_FOUND)
    set(CUDA_VERSION_STRING ${CUDAToolkit_VERSION})
  endif()
  if(NOT CUDA_VERSION_STRING VERSION_EQUAL @PROJECT_NAME@_CUDA_VERSION)
      message(FATAL_ERROR "@PROJECT_NAME@ library was compiled with CUDA ${@PROJECT_NAME@_CUDA_VERSION} support. Please, use the same version or rebuild @PROJECT_NAME@ with CUDA ${CUDA_VERSION_STRING}")
  endif()
endif()
