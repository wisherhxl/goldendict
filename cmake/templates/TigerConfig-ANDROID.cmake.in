# Android API level from which @PROJECT_NAME@ has been compiled is remembered
set(@PROJECT_NAME@_ANDROID_NATIVE_API_LEVEL "${@PROJECT_NAME@_ANDROID_NATIVE_API_LEVEL_CONFIGCMAKE}")

# ==============================================================
#  Check @PROJECT_NAME@ availability
# ==============================================================
if(@PROJECT_NAME@_ANDROID_NATIVE_API_LEVEL GREATER ANDROID_NATIVE_API_LEVEL)
  if(NOT @PROJECT_NAME@_FIND_QUIETLY)
    message(WARNING "Minimum required by @PROJECT_NAME@ API level is android-${@PROJECT_NAME@_ANDROID_NATIVE_API_LEVEL}")
  endif()
  set(@PROJECT_NAME@_FOUND 0)
  return()
endif()
