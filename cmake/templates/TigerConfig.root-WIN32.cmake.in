# ===================================================================================
#  The @PROJECT_NAME@ CMake configuration file
#
#             ** File generated automatically, do not modify **
#
#  Usage from an external project:
#    In your CMakeLists.txt, add these lines:
#
#    FIND_PACKAGE(@PROJECT_NAME@ REQUIRED)
#    TARGET_LINK_LIBRARIES(MY_TARGET_NAME ${@PROJECT_NAME@_LIBS})
#
#    Or you can search for specific @PROJECT_NAME@ modules:
#
#    FIND_PACKAGE(@PROJECT_NAME@ REQUIRED core imgcodecs)
#
#    If the module is found then @PROJECT_NAME@_<MODULE>_FOUND is set to TRUE.
#
#    This file will define the following variables:
#      - @PROJECT_NAME@_LIBS                     : The list of libraries to link against.
#      - @PROJECT_NAME@_INCLUDE_DIRS             : The @PROJECT_NAME@ include directories.
#      - @PROJECT_NAME@_COMPUTE_CAPABILITIES     : The version of compute capability
#      - @PROJECT_NAME@_VERSION                  : The version of this @PROJECT_NAME@ build: "@TIGER_VERSION_PLAIN@"
#      - @PROJECT_NAME@_VERSION_MAJOR            : Major version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_MAJOR@"
#      - @PROJECT_NAME@_VERSION_MINOR            : Minor version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_MINOR@"
#      - @PROJECT_NAME@_VERSION_PATCH            : Patch version part of @PROJECT_NAME@_VERSION: "@TIGER_VERSION_PATCH@"
#      - @PROJECT_NAME@_VERSION_STATUS           : Development status of this build: "@TIGER_VERSION_STATUS@"
#
#    Advanced variables:
#      - @PROJECT_NAME@_SHARED
#
# ===================================================================================
#
#    Windows pack specific options:
#      - @PROJECT_NAME@_STATIC
#      - @PROJECT_NAME@_CUDA

if(CMAKE_VERSION VERSION_GREATER 2.6)
  get_property(@PROJECT_NAME@_LANGUAGES GLOBAL PROPERTY ENABLED_LANGUAGES)
  if(NOT ";${@PROJECT_NAME@_LANGUAGES};" MATCHES ";CXX;")
    enable_language(CXX)
  endif()
endif()

if(NOT DEFINED @PROJECT_NAME@_STATIC)
  # look for global setting
  if(NOT DEFINED BUILD_SHARED_LIBS OR BUILD_SHARED_LIBS)
    set(@PROJECT_NAME@_STATIC OFF)
  else()
    set(@PROJECT_NAME@_STATIC ON)
  endif()
endif()

if(NOT DEFINED @PROJECT_NAME@_CUDA)
  # if user' app uses CUDA, then it probably wants CUDA-enabled @PROJECT_NAME@ binaries
  if(CUDA_FOUND)
    set(@PROJECT_NAME@_CUDA ON)
  endif()
endif()

function(check_one_config RES)
  set(${RES} "" PARENT_SCOPE)
  if(NOT @PROJECT_NAME@_RUNTIME OR NOT @PROJECT_NAME@_ARCH)
    return()
  endif()
  set(candidates)
  if(@PROJECT_NAME@_STATIC)
    list(APPEND candidates "${@PROJECT_NAME@_ARCH}/${@PROJECT_NAME@_RUNTIME}/staticlib")
  endif()
  if(@PROJECT_NAME@_CUDA)
    list(APPEND candidates "gpu/${@PROJECT_NAME@_ARCH}/${@PROJECT_NAME@_RUNTIME}/lib")
  endif()
  if(@PROJECT_NAME@_CUDA AND @PROJECT_NAME@_STATIC)
    list(APPEND candidates "gpu/${@PROJECT_NAME@_ARCH}/${@PROJECT_NAME@_RUNTIME}/staticlib")
  endif()
  list(APPEND candidates "${@PROJECT_NAME@_ARCH}/${@PROJECT_NAME@_RUNTIME}/lib")
  foreach(c ${candidates})
    set(p "${@PROJECT_NAME@_CONFIG_PATH}/${c}")
    if(EXISTS "${p}/@PROJECT_NAME@Config.cmake")
      set(${RES} "${p}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

get_filename_component(@PROJECT_NAME@_CONFIG_PATH "${CMAKE_CURRENT_LIST_FILE}" DIRECTORY)

if((NOT DEFINED CMAKE_SYSTEM_PROCESSOR OR CMAKE_SYSTEM_PROCESSOR STREQUAL "")
    AND NOT @PROJECT_NAME@_SUPPRESS_MESSAGE_MISSING_CMAKE_SYSTEM_PROCESSOR)
  message(WARNING "@PROJECT_NAME@: CMAKE_SYSTEM_PROCESSOR is not defined. Perhaps CMake toolchain is broken")
endif()
if(NOT DEFINED CMAKE_SIZEOF_VOID_P
    AND NOT @PROJECT_NAME@_SUPPRESS_MESSAGE_MISSING_CMAKE_SIZEOF_VOID_P)
  message(WARNING "@PROJECT_NAME@: CMAKE_SIZEOF_VOID_P is not defined. Perhaps CMake toolchain is broken")
endif()

if(DEFINED @PROJECT_NAME@_ARCH AND DEFINED @PROJECT_NAME@_RUNTIME)
  # custom overridden values
elseif(MSVC)
  # see Modules/CMakeGenericSystem.cmake
  if("${CMAKE_GENERATOR}" MATCHES "(Win64|IA64)")
    set(@PROJECT_NAME@_ARCH "x64")
  elseif("${CMAKE_GENERATOR_PLATFORM}" MATCHES "ARM64")
    set(@PROJECT_NAME@_ARCH "ARM64")
  elseif("${CMAKE_GENERATOR}" MATCHES "ARM")
    set(@PROJECT_NAME@_ARCH "ARM")
  elseif("${CMAKE_SIZEOF_VOID_P}" STREQUAL "8")
    set(@PROJECT_NAME@_ARCH "x64")
  else()
    set(@PROJECT_NAME@_ARCH x86)
  endif()

  if(MSVC_VERSION EQUAL 1400)
    set(@PROJECT_NAME@_RUNTIME vc8)
  elseif(MSVC_VERSION EQUAL 1500)
    set(@PROJECT_NAME@_RUNTIME vc9)
  elseif(MSVC_VERSION EQUAL 1600)
    set(@PROJECT_NAME@_RUNTIME vc10)
  elseif(MSVC_VERSION EQUAL 1700)
    set(@PROJECT_NAME@_RUNTIME vc11)
  elseif(MSVC_VERSION EQUAL 1800)
    set(@PROJECT_NAME@_RUNTIME vc12)
  elseif(MSVC_VERSION EQUAL 1900)
    set(@PROJECT_NAME@_RUNTIME vc14)
  elseif(MSVC_VERSION MATCHES "^191[0-9]$")
    set(@PROJECT_NAME@_RUNTIME vc15)
    check_one_config(has_VS2017)
    if(NOT has_VS2017)
      set(@PROJECT_NAME@_RUNTIME vc14) # selecting previous compatible runtime version
    endif()
  elseif(MSVC_VERSION MATCHES "^192[0-9]$")
    set(@PROJECT_NAME@_RUNTIME vc16)
    check_one_config(has_VS2019)
    if(NOT has_VS2019)
      set(@PROJECT_NAME@_RUNTIME vc15) # selecting previous compatible runtime version
      check_one_config(has_VS2017)
      if(NOT has_VS2017)
        set(@PROJECT_NAME@_RUNTIME vc14) # selecting previous compatible runtime version
      endif()
    endif()
  elseif(MSVC_VERSION MATCHES "^19[34][0-9]$")
    set(@PROJECT_NAME@_RUNTIME vc17)
    check_one_config(has_VS2022)
    if(NOT has_VS2022)
     set(@PROJECT_NAME@_RUNTIME vc16)
     check_one_config(has_VS2019)
     if(NOT has_VS2019)
       set(@PROJECT_NAME@_RUNTIME vc15) # selecting previous compatible runtime version
       check_one_config(has_VS2017)
       if(NOT has_VS2017)
         set(@PROJECT_NAME@_RUNTIME vc14) # selecting previous compatible runtime version
       endif()
     endif()
    endif()
  endif()
elseif(MINGW)
  set(@PROJECT_NAME@_RUNTIME mingw)

  if(CMAKE_SYSTEM_PROCESSOR MATCHES "amd64.*|x86_64.*|AMD64.*")
    set(@PROJECT_NAME@_ARCH x64)
  else()
    set(@PROJECT_NAME@_ARCH x86)
  endif()
endif()

check_one_config(@PROJECT_NAME@_LIB_PATH)

if(NOT @PROJECT_NAME@_FIND_QUIETLY)
  message(STATUS "@PROJECT_NAME@ ARCH: ${@PROJECT_NAME@_ARCH}")
  message(STATUS "@PROJECT_NAME@ RUNTIME: ${@PROJECT_NAME@_RUNTIME}")
  message(STATUS "@PROJECT_NAME@ STATIC: ${@PROJECT_NAME@_STATIC}")
endif()

if(@PROJECT_NAME@_LIB_PATH AND EXISTS "${@PROJECT_NAME@_LIB_PATH}/@PROJECT_NAME@Config.cmake")
  include("${@PROJECT_NAME@_LIB_PATH}/@PROJECT_NAME@Config.cmake")

  if(NOT @PROJECT_NAME@_FIND_QUIETLY)
    message(STATUS "Found @PROJECT_NAME@ @TIGER_VERSION@ in ${@PROJECT_NAME@_LIB_PATH}")
    if(NOT @PROJECT_NAME@_LIB_PATH MATCHES "/staticlib")
      get_filename_component(_@PROJECT_NAME@_LIB_PATH "${@PROJECT_NAME@_LIB_PATH}/../bin" ABSOLUTE)
      file(TO_NATIVE_PATH "${_@PROJECT_NAME@_LIB_PATH}" _@PROJECT_NAME@_LIB_PATH)
      message(STATUS "You might need to add ${_@PROJECT_NAME@_LIB_PATH} to your PATH to be able to run your applications.")
      if(@PROJECT_NAME@_LIB_PATH MATCHES "/gpu/")
        string(REPLACE "\\gpu" "" _@PROJECT_NAME@_LIB_PATH2 "${_@PROJECT_NAME@_LIB_PATH}")
        message(STATUS "GPU support is enabled so you might also need ${_@PROJECT_NAME@_LIB_PATH2} in your PATH (it must go after the ${_@PROJECT_NAME@_LIB_PATH}).")
      endif()
    endif()
  endif()
else()
  if(NOT @PROJECT_NAME@_FIND_QUIETLY)
    message(WARNING
"Found @PROJECT_NAME@ Windows Pack but it has no binaries compatible with your configuration.
You should manually point CMake variable @PROJECT_NAME@_DIR to your build of @PROJECT_NAME@ library."
    )
  endif()
  set(@PROJECT_NAME@_FOUND FALSE)
endif()
